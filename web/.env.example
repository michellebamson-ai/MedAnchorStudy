# Copy to .env and fill in. Never commit a real .env.
#
# Required in every environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="https://your-app.example.com"

# ---------------------------------------------------------------------------
# Local development only.
#
# BYPASS_AUTH=1 skips sign-in and treats every visitor as the shared demo
# student demo@medanchor.local. Everything they upload, plan or generate lands
# on that one account.
#
# It is ignored when NODE_ENV=production unless ALLOW_DEMO_IN_PRODUCTION=1 is
# also set, so a stray .env cannot ship a deployed app as a single identity.
# Leave both unset in production.
# ---------------------------------------------------------------------------
# BYPASS_AUTH="1"
# ALLOW_DEMO_IN_PRODUCTION="1"

# ---------------------------------------------------------------------------
# Transactional email (Resend). Required for password reset.
#
# Both values are needed. With only the key set, mailerStatus() reports
# "disabled" and nothing is delivered. Without them, a student who forgets
# their password is locked out permanently — preflight blocks production.
#
#   1. resend.com -> API Keys -> create
#   2. resend.com -> Domains -> verify a sending domain
#   3. MAIL_FROM must be an address on a domain you have verified
#
# Create at https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxx"
# MAIL_FROM="MedAnchor Study <you@yourdomain.com>"

# ---------------------------------------------------------------------------
# Object storage. Uploads go to data/uploads on local disk without this, and a
# host with an ephemeral filesystem deletes them on every redeploy.
#
# Either provider works. Backblaze B2 needs no credit card; Cloudflare R2 does.
#
# --- Backblaze B2 -------------------------------------------------------
# 1. backblaze.com/cloud-storage -> Create Bucket (name it, e.g. medanchor)
#    Tick "Free to Download". Note the endpoint it shows, which contains a
#    region, for example:
#      https://s3.us-west-004.backblazestorage.com
# 2. Buckets -> App Keys -> Add New Key
#    Name it, set "Files" capabilities to Read & Write,
#    and restrict "Bucket Name" to the bucket from step 1.
# 3. Copy the ApplicationKeyID and the Application Key (shown once).
#
# The region MUST match the endpoint (us-west-004 above) or B2 answers
# SignatureDoesNotMatch. R2 accepts "auto" instead.
#
# --- Cloudflare R2 -----------------------------------------------------
# Endpoint is https://<account-id>.r2.cloudflarestorage.com, region stays auto.
#
# Verify with: npm run check:storage:live
#
# OBJECT_STORAGE_ENDPOINT="https://s3.us-west-004.backblazestorage.com"
# OBJECT_STORAGE_BUCKET="medanchor"
# OBJECT_STORAGE_ACCESS_KEY_ID="K005xxxxxxxxxxxx"
# OBJECT_STORAGE_SECRET_ACCESS_KEY="K005xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OBJECT_STORAGE_REGION="us-west-004"

# ---------------------------------------------------------------------------
# AI providers — chat and content are routed separately.
#
# Chat (tutor turns, role-play) is latency-bound: a student is staring at a
# loading dot, so it goes wherever the model is fastest.
# Content (study materials, grading) is accuracy-bound: a confident wrong
# medical fact is the worst failure this product can have, so it goes to the
# strongest model configured.
#
# Default precedence per lane:
#   chat    — Groq, then Claude, then Gemini, then deterministic
#   content — Claude, then Gemini, then Groq, then deterministic
# Override with AI_CHAT_PROVIDER / AI_CONTENT_PROVIDER. Force everything
# offline with AI_PROVIDER=simulated.
#
# Each provider needs BOTH its key and its model id. The model id is never
# defaulted, because model ids are versioned and get renamed, and a hardcoded
# guess would fail every request at runtime.
#
# PRIVACY: the free Gemini tier's terms state submitted content may be used to
# improve Google's products. Fine for development; not acceptable for real
# student data in a health-education product. Use Claude for production.
# No real patient records in any provider, ever.
# ---------------------------------------------------------------------------

# Groq — fastest, best for tutor and role-play. List models:
#   GET https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# GROQ_API_KEY=""
# GROQ_MODEL=""
# GROQ_TIMEOUT_MS="30000"

# Gemini — free tier, no credit card. List models:
#   GET https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: $GEMINI_API_KEY"
# GEMINI_API_KEY=""
# GEMINI_MODEL=""

# Claude — strongest, preferred for anything accuracy-bound.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""

# AI_CHAT_PROVIDER="groq"
# AI_CONTENT_PROVIDER="claude"
# AI_PROVIDER="simulated"

# ---------- Google Sign-In (optional) ----------
# Until both are set, the login screen hides the Google button entirely rather
# than offering one that fails at Google's redirect.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/callback/google
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
